/* QuizForge — дизайн-система (темна тема). Плейсхолдери @...@ підставляє core/ui_theme.py */

/* ---------- База ---------- */
QWidget {
    font-family: "Inter", "Segoe UI Variable", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 14px;
    background-color: #0B0F17;
    color: #E6EDF7;
}
QMainWindow, QDialog, QMessageBox { background-color: #0B0F17; }
QLabel, QCheckBox, QRadioButton, QScrollArea, QAbstractScrollArea > QWidget > QWidget { background: transparent; }
QScrollArea { border: none; }
QToolTip { background-color: #1A2332; color: #E6EDF7; border: 1px solid #2F3D55; padding: 6px 8px; border-radius: 6px; }

/* ---------- Типографіка ---------- */
QLabel#titleLabel   { font-size: 24px; font-weight: 700; color: #FFFFFF; }
QLabel#subtitleLabel{ font-size: 13px; color: #9AA8BD; }
QLabel#logoLabel    { font-size: 18px; font-weight: 700; color: #FFFFFF; }
QLabel#bodyLabel    { font-size: 16px; color: #E6EDF7; }
QLabel#sectionLabel { font-size: 15px; font-weight: 600; color: #FFFFFF; }
QLabel#progressLabel{ font-size: 14px; font-weight: 600; color: #9AA8BD; }
QLabel#questionLabel{ font-size: 24px; font-weight: 600; color: #FFFFFF; padding: 8px 0; }
QLabel#timerLabel   { font-size: 28px; font-weight: 700; color: #FFFFFF; padding: 4px 14px; border-radius: 8px; }
QLabel#timerLabel[low="true"] { background-color: #B91C1C; color: #FFFFFF; }
QLabel#hintLabel    { background-color: @ACCENT_SOFT@; border: 1px solid @ACCENT@; border-radius: 8px; padding: 8px 12px; color: #DBEAFE; font-size: 12px; }
QLabel#debugBar     { background: #131A26; color: #9AA8BD; font-family: Consolas, monospace; font-size: 11px; padding: 4px 8px; border-radius: 4px; }
QLabel#rulesLabel   { font-size: 15px; padding: 16px 18px; background-color: #0F1520; border: 1px solid #243044; border-radius: 10px; }

/* ---------- Картки ---------- */
QFrame#card, QWidget#card { background-color: #131A26; border: 1px solid #243044; border-radius: 12px; }
QFrame#card QLabel, QWidget#card QLabel { background: transparent; }

/* ---------- Поля ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0F1520;
    border: 1px solid #2F3D55;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 22px;
    color: #E6EDF7;
    selection-background-color: @ACCENT@;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #3B4A63; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid @ACCENT@; }
QLineEdit:disabled, QTextEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: #6B7A93; background-color: #131A26; }
QLineEdit[error="true"] { border-color: #F87171; }
QComboBox QAbstractItemView { background-color: #131A26; border: 1px solid #2F3D55; selection-background-color: #1B2D4D; outline: none; }

/* ---------- Кнопки: за замовчуванням вторинні ---------- */
QPushButton {
    background-color: #1A2332;
    color: #E6EDF7;
    border: 1px solid #2F3D55;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 22px;
}
QPushButton:hover { background-color: #222E42; border-color: #3B4A63; }
QPushButton:pressed { background-color: #131A26; }
QPushButton:focus { border-color: @ACCENT@; }
QPushButton:disabled { background-color: #131A26; color: #6B7A93; border-color: #1C2636; }

QPushButton#primaryButton { background-color: @ACCENT@; border-color: @ACCENT@; color: #FFFFFF; font-weight: 600; }
QPushButton#primaryButton:hover { background-color: @ACCENT_HOVER@; border-color: @ACCENT_HOVER@; }
QPushButton#primaryButton:pressed { background-color: @ACCENT_PRESSED@; border-color: @ACCENT_PRESSED@; }
QPushButton#primaryButton:disabled { background-color: #1B2D4D; border-color: #1B2D4D; color: #6B7A93; }

QPushButton#dangerButton { color: #FCA5A5; }
QPushButton#dangerButton:hover { background-color: #3A1D22; border-color: #F87171; }
QPushButton#dangerButton:disabled { color: #6B7A93; }

/* ---------- Навігація адмінки ---------- */
QWidget#topbar { background-color: #0F1520; border-bottom: 1px solid #243044; }
QWidget#topbar QLabel { background: transparent; }
QPushButton#navTab {
    background: transparent; border: none; border-bottom: 2px solid transparent; border-radius: 0;
    color: #9AA8BD; font-weight: 500; padding: 16px 4px; margin: 0 14px;
}
QPushButton#navTab:hover { color: #FFFFFF; background: transparent; }
QPushButton#navTab:checked { color: #FFFFFF; border-bottom: 2px solid @ACCENT@; }

/* ---------- Таблиці ---------- */
QTableWidget, QTableView {
    background-color: #131A26;
    alternate-background-color: #131A26;
    border: 1px solid #243044;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #1B2D4D;
    selection-color: #FFFFFF;
    outline: none;
}
QTableWidget::item, QTableView::item { padding: 10px 14px; border: none; border-bottom: 1px solid #1C2636; }
QTableWidget::item:hover, QTableView::item:hover { background-color: #1A2536; }
QTableWidget::item:selected, QTableView::item:selected { background-color: #1B2D4D; color: #FFFFFF; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background-color: #131A26; color: #9AA8BD; padding: 12px 14px; border: none;
    border-bottom: 1px solid #243044; font-size: 12px; font-weight: 600; text-align: left;
}
QTableCornerButton::section { background-color: #131A26; border: none; border-bottom: 1px solid #243044; }

/* ---------- Списки ---------- */
QListWidget { background-color: #131A26; border: 1px solid #243044; border-radius: 10px; outline: none; padding: 4px; }
QListWidget::item { padding: 10px 12px; border-radius: 8px; }
QListWidget::item:hover { background-color: #1A2536; }
QListWidget::item:selected { background-color: #1B2D4D; color: #FFFFFF; }

/* ---------- Групи ---------- */
QGroupBox { background-color: #131A26; border: 1px solid #243044; border-radius: 12px; margin-top: 18px; padding: 20px 14px 14px 14px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 14px; padding: 0 6px; color: #FFFFFF; background: #0B0F17; }

/* ---------- Чекбокси та радіо (SVG-індикатори з акцентом) ---------- */
QCheckBox, QRadioButton { spacing: 12px; }
QCheckBox::indicator, QRadioButton::indicator { width: 20px; height: 20px; border: none; background: transparent; }
QRadioButton::indicator:unchecked { image: url(@ICONS@/radio-off.svg); }
QRadioButton::indicator:unchecked:hover { image: url(@ICONS@/radio-off-hover.svg); }
QRadioButton::indicator:checked { image: url(@ICONS@/radio-on.svg); }
QCheckBox::indicator:unchecked { image: url(@ICONS@/check-off.svg); }
QCheckBox::indicator:unchecked:hover { image: url(@ICONS@/check-off-hover.svg); }
QCheckBox::indicator:checked { image: url(@ICONS@/check-on.svg); }
QCheckBox:disabled, QRadioButton:disabled { color: #6B7A93; }

/* ---------- Варіанти відповідей у тесті (картки) ---------- */
QRadioButton#optionCard, QCheckBox#optionCard {
    font-size: 17px; padding: 18px 22px; spacing: 16px; min-height: 28px;
    background-color: #131A26; border: 1px solid #2F3D55; border-radius: 12px;
}
QRadioButton#optionCard:hover, QCheckBox#optionCard:hover { border-color: #3B4A63; background-color: #1A2332; }
QRadioButton#optionCard:checked, QCheckBox#optionCard:checked { border: 1px solid @ACCENT@; background-color: @ACCENT_SOFT@; color: #FFFFFF; }
QRadioButton#optionCard:focus, QCheckBox#optionCard:focus { border-color: @ACCENT@; }

/* ---------- Прогрес, скрол, спліттер, статус ---------- */
QProgressBar { background: #243044; border: none; border-radius: 3px; max-height: 6px; min-height: 6px; text-align: center; color: transparent; }
QProgressBar::chunk { background: @ACCENT@; border-radius: 3px; }
QScrollBar:vertical { background: transparent; width: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: #3B4A63; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #5B6B85; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3B4A63; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #5B6B85; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: #243044; }
QSplitter::handle:hover { background: @ACCENT@; }
QStatusBar { background: #0F1520; color: #9AA8BD; }
QMenu { background-color: #131A26; border: 1px solid #2F3D55; padding: 4px; }
QMenu::item { padding: 8px 20px; border-radius: 6px; }
QMenu::item:selected { background-color: #1B2D4D; }

/* ---------- Списки, що випадають, і лічильники (власні стрілки) ---------- */
QComboBox { padding-right: 36px; }
QComboBox::drop-down { border: none; width: 34px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(@ICONS@/chevron-down.svg); width: 12px; height: 12px; }
QSpinBox, QDoubleSpinBox { padding-right: 30px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 26px; border: none; background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 26px; border: none; background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@ICONS@/chevron-up.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@ICONS@/chevron-down.svg); width: 10px; height: 10px; }

/* ---------- Діалоги ---------- */
QDialog#themed { background-color: #0B0F17; }
QLabel#dialogTitle { font-size: 18px; font-weight: 600; color: #FFFFFF; }
QLabel#dialogText { font-size: 14px; color: #D5DEEC; }
QLabel#fieldLabel { font-size: 12px; font-weight: 500; color: #9AA8BD; }
QLabel#errorLabel { font-size: 13px; color: #FCA5A5; background-color: #3A1D22; border: 1px solid #7F2A33; border-radius: 8px; padding: 8px 12px; }
QLabel#dialogIcon { min-width: 44px; max-width: 44px; min-height: 44px; max-height: 44px; border-radius: 22px; font-size: 22px; font-weight: 700; qproperty-alignment: AlignCenter; }
QLabel#dialogIcon[kind="info"] { background-color: #12305E; color: #93C5FD; }
QLabel#dialogIcon[kind="question"] { background-color: #12305E; color: #93C5FD; }
QLabel#dialogIcon[kind="warn"] { background-color: #4A3A0C; color: #FDE68A; }
QLabel#dialogIcon[kind="error"] { background-color: #4A1D22; color: #FCA5A5; }
QLabel#dialogIcon[kind="ok"] { background-color: #0F3D2E; color: #6EE7B7; }
QFrame#divider { background-color: #243044; border: none; min-height: 1px; max-height: 1px; }
QPushButton#ghostButton { background: transparent; border: none; color: #9AA8BD; padding: 6px 10px; min-width: 0; }
QPushButton#ghostButton:hover { color: #FFFFFF; background: transparent; }
QFrame#statCard { background-color: #131A26; border: 1px solid #243044; border-radius: 12px; }
QLabel#statValue { font-size: 28px; font-weight: 700; color: #FFFFFF; }
QLabel#statValue[kind="ok"] { color: #6EE7B7; }
QLabel#statValue[kind="warn"] { color: #FDE68A; }
QLabel#statValue[kind="bad"] { color: #FCA5A5; }

/* ---------- Екран тесту ---------- */
QWidget#quizTopbar { background-color: #0F1520; border-bottom: 1px solid #243044; }
QWidget#quizFooter { background-color: #0F1520; border-top: 1px solid #243044; }
QWidget#quizTopbar QLabel, QWidget#quizFooter QLabel { background: transparent; }
QLabel#questionMeta { font-size: 13px; font-weight: 500; color: #9AA8BD; }
QLabel#userLabel { font-size: 13px; color: #9AA8BD; }
QLabel#recDot { color: #34D399; font-size: 12px; }
QPushButton#navButton { min-height: 28px; padding: 10px 26px; font-size: 15px; }
QLineEdit#openAnswer { font-size: 17px; padding: 14px 16px; border-radius: 12px; }
QLineEdit#codeInput { font-size: 26px; font-weight: 600; letter-spacing: 10px; border-radius: 12px; }
QLabel#ruleIcon { min-width: 24px; max-width: 24px; min-height: 24px; max-height: 24px; border-radius: 12px; background-color: #4A1D22; color: #FCA5A5; font-size: 12px; font-weight: 700; }
QLabel#thumb { border: 1px solid #2F3D55; border-radius: 8px; padding: 2px; }
